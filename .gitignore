# Node.js dependencies
node_modules/ 
# Ignore the directory where npm installs dependencies.

# Compiled TypeScript output
dist/ 
# Ignore the directory where TypeScript compiles your code to JavaScript.
*.js.map 
# Ignore sourcemap files generated by TypeScript.

# Logs and diagnostic reports
logs/
*.log 
# Ignore log files.
npm-debug.log* 
# Ignore npm debug logs.
yarn-debug.log* 
# Ignore yarn debug logs.
yarn-error.log* 
# Ignore yarn error logs.
lerna-debug.log* 
# Ignore lerna debug logs.
.pnpm-debug.log* 
# Ignore pnpm debug logs.
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json 
# Ignore diagnostic reports.

# Runtime data
pids/ 
# Ignore pid files
*.pid 
# Ignore pid files.
*.seed 
# Ignore seed files.
*.pid.lock 
# Ignore lock files.

# Test coverage
coverage/ 
# Ignore the directory for test coverage reports.
.nyc_output 
# Ignore nyc test coverage output.
*.lcov 
# Ignore lcov files.

# Environment variables
.env 
# Ignore the .env file containing sensitive environment variables.
.env.* 
# Ignore any other files starting with .env.

# Editor configuration (optional)
.vscode/ 
# Ignore VS Code configuration files.

# macOS specific files
.DS_Store 
# Ignore macOS folder metadata files.

# Build and temporary files (customize as needed)
/build 
# If you use a custom build output directory, replace 'build' with its name.
*.tmp
*.bak
/src/generated/prisma
